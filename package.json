{
  "name": "lyra-campus",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "test:catalog": "node scripts/generateCurricula.mjs --check",
    "test:browser": "node scripts/checkBrowser.mjs",
    "test:worker": "node --test workers/geoduelo/test/*.test.mjs",
    "test:repository": "node scripts/checkRepositorySafety.mjs",
    "check": "npm run test:repository && npm run test:catalog && npm test && npm run test:worker && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "read-excel-file": "6.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "playwright": "1.62.1",
    "vite": "^5.0.0",
    "esbuild": "0.21.5"
  },
  "workspaces": [
    "workers/geoduelo"
  ]
}

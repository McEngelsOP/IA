{
  "name": "lyra-campus",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/buildOffline.mjs",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "test:catalog": "node scripts/generateCurricula.mjs --check && node scripts/systemCatalogSeed.mjs --check",
    "test:browser": "node scripts/checkBrowser.mjs",
    "test:worker": "node --test workers/geoduelo/test/*.test.mjs",
    "test:repository": "node scripts/checkRepositorySafety.mjs",
    "check": "npm run test:repository && npm run test:catalog && npm test && npm run test:worker && npm run build",
    "test:offline": "node scripts/checkOffline.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "pdfjs-dist": "6.5.438",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "read-excel-file": "6.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "vite": "6.4.5"
  },
  "workspaces": [
    "workers/geoduelo"
  ]
}

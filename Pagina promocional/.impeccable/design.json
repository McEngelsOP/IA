    {
      "name": "Acción principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Entrada principal a la plataforma.",
      "html": "<button class=\"ds-primary\">Entrar a ASEGEM <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:52px;padding:13px 23px;border-radius:100px;font-size:14px;line-height:1.4;font-weight:600;transition:background .2s,color .2s;font-family:Rubik,Arial,sans-serif;border:0;background:var(--accent,#e6db8a);color:var(--accent-ink,#263327)}.ds-primary:hover{background:#f3eaa6}.ds-primary:focus-visible{outline:3px solid var(--accent,#e6db8a);outline-offset:5px}.ds-primary:disabled{opacity:.55;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Acción alternativa",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Acción secundaria junto a una acción principal.",
      "html": "<button class=\"ds-outline\">Reiniciar</button>",
      "css": ".ds-outline{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:52px;padding:13px 23px;border-radius:100px;font-size:14px;line-height:1.4;font-weight:600;transition:background .2s,color .2s;font-family:Rubik,Arial,sans-serif;background:transparent;border:1px solid #7d8a7c;color:var(--ink,#f5f1e5)}.ds-outline:hover{background:#ffffff0d}.ds-outline:focus-visible{outline:3px solid var(--accent,#e6db8a);outline-offset:5px}.ds-outline:disabled{opacity:.55;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-outline{transition:none}}"
    },
    {
